#include <iostream>
#include <iomanip>
#include <string>
#include <cctype>
using namespace std;

struct InventoryItem {
    string itemCode;
    string itemName;
    double cost;
    double sellingPrice;
};

string generateItemCode(const string& itemName, int runningNumber) {
    string prefix;

    for (int i = 0; i < 3 && i < static_cast<int>(itemName.length()); ++i) {
        prefix += static_cast<char>(toupper(
            static_cast<unsigned char>(itemName[i])));
    }

    while (prefix.length() < 3) prefix += 'X';

    return prefix + "_" + to_string(runningNumber);
}

InventoryItem insertItem(int runningNumber) {
    InventoryItem item;

    cout << "Enter item name: ";
    getline(cin >> ws, item.itemName);

    cout << "Enter item cost: ";
    cin >> item.cost;

    while (item.cost < 0) {
        cout << "Cost cannot be negative. Enter item cost again: ";
        cin >> item.cost;
    }

    item.itemCode = generateItemCode(item.itemName, runningNumber);
    item.sellingPrice = item.cost * 1.40;

    return item;
}

void displayStock(const InventoryItem* items, const int count) {
    cout << "\n---------------- Inventory Stock ----------------\n";
    cout << left << setw(15) << "Item Code"
         << setw(25) << "Item Name"
         << right << setw(12) << "Cost"
         << setw(16) << "Selling Price" << '\n';

    for (int i = 0; i < count; ++i) {
        cout << left << setw(15) << items[i].itemCode
             << setw(25) << items[i].itemName
             << right << setw(12) << fixed << setprecision(2) << items[i].cost
             << setw(16) << items[i].sellingPrice << '\n';
    }
}

int main() {
    const int ITEM_COUNT = 10;
    const int FIRST_CODE_NUMBER = 31203;
    InventoryItem inventory[ITEM_COUNT];

    cout << "Enter details for " << ITEM_COUNT << " inventory items.\n";
    for (int i = 0; i < ITEM_COUNT; ++i) {
        cout << "\nItem " << i + 1 << ":\n";
        inventory[i] = insertItem(FIRST_CODE_NUMBER + i);
    }

    displayStock(inventory, ITEM_COUNT);
    return 0;
}